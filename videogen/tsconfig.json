{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "declaration": true,
    "allowJs": true,
    "checkJs": false,
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist",
    "rootDir": "runtime",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["runtime/**/*.ts", "runtime/**/*.tsx", "runtime/**/*.jsx", "runtime/**/*.mjs"]
}
