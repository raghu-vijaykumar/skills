{
  "name": "@raghu-vijaykumar/videogen",
  "version": "0.4.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "type": "module",
  "description": "Content Studio video lifecycle skills and reusable Remotion runtime",
  "files": [
    "content-studio/"
  ],
  "bin": {
    "videogen": "./content-studio/toolkit/videogen/scripts/cli.mjs",
    "content-studio": "./content-studio/scripts/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./content-studio/toolkit/videogen/dist/project.d.ts",
      "default": "./content-studio/toolkit/videogen/dist/project.js"
    },
    "./cli": "./content-studio/toolkit/videogen/scripts/cli.mjs",
    "./content-package": "./content-studio/toolkit/videogen/scripts/content-package.mjs",
    "./gate/*": "./content-studio/toolkit/videogen/dist/gates/check-*.mjs",
    "./runtime/design/contentStyles": {
      "types": "./content-studio/toolkit/videogen/dist/design/contentStyles.d.mts",
      "default": "./content-studio/toolkit/videogen/dist/design/contentStyles.mjs"
    },
    "./runtime/*": {
      "types": "./content-studio/toolkit/videogen/dist/*.d.ts",
      "default": "./content-studio/toolkit/videogen/dist/*.js"
    },
    "./skill": "./content-studio/skills/content-studio-animate/SKILL.md",
    "./runtime/hairline": {
      "types": "./content-studio/toolkit/videogen/dist/hairline.d.ts",
      "default": "./content-studio/toolkit/videogen/dist/hairline.js"
    }
  },
  "scripts": {
    "build": "tsc -p content-studio/toolkit/videogen/tsconfig.json && node content-studio/toolkit/videogen/scripts/copy-static.mjs && node content-studio/toolkit/videogen/scripts/transpile-gates.mjs",
    "check:docs": "node content-studio/scripts/check-docs.mjs",
    "test": "npm run build && node content-studio/toolkit/videogen/dist/gates/check-animation-core.mjs && node --test content-studio/toolkit/videogen/tests/*.test.mjs content-studio/tests/*.test.mjs",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.518",
    "@remotion/renderer": "4.0.518",
    "yaml": "2.8.1"
  },
  "peerDependencies": {
    "@react-three/fiber": "^9.7.0",
    "@remotion/cli": "4.0.518",
    "@remotion/fonts": "4.0.518",
    "@remotion/media-utils": "4.0.518",
    "@remotion/three": "4.0.518",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.518",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/three": "^0.186.0",
    "esbuild": "0.28.1",
    "typescript": "^7.0.2"
  }
}
