# Copy to the channel workspace at code/secrets/digest.env and fill in. Keep it Git-ignored.
#
# Create a bot: message @BotFather on Telegram -> /newbot -> copy the token.
# Get your chat id: start a chat with the bot, send it any message, then open
#   https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
# and read result[0].message.chat.id (private chats are positive numbers,
# channels start with -100). Alternatively add the bot to a channel as admin.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional. A GitHub personal access token (public read is enough) raises the
# Search API rate limit used for the "New & Viral Repos" section. Without it,
# unauthenticated search is limited to ~10 requests/minute, which is fine for a
# single daily run.
GITHUB_TOKEN=
